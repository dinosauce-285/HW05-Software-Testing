          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Luu token vao properties token_N" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def tok = vars.get("tokenVal")

if (tok == null || tok == "TOKEN_KHONG_LAY_DUOC") {
    log.error("Khong lay duoc token cho " + vars.get("email") + " - dung test")
    prev.setSuccessful(false)
    return
}

def n = ((props.get("tokenCount") ?: "0") as String) as Integer
n = n + 1
props.put("tokenCount", n.toString())
props.put("token_" + n, tok)</stringProp>
          </JSR223PostProcessor>
