          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Assert 4 - orderId phai la so nguyen duong" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper

def body = prev.getResponseDataAsString()
def payload

try {
    payload = new JsonSlurper().parseText(body)
} catch (Exception e) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("Phan hoi khong phai JSON hop le: " + body.take(200))
    return
}

if (!(payload.orderId instanceof Number) || payload.orderId &lt;= 0) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("Thieu orderId hop le trong phan hoi checkout: " + body.take(200))
    return
}

if (payload.message != "Checkout successful") {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("Thong bao checkout khong dung: " + payload.message)
}</stringProp>
          </JSR223Assertion>
