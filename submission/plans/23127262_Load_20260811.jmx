        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert 1 - ma phan hoi khop CSV" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="0">${expect_code}</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message">Ma phan hoi khong khop cot expect_code trong CSV</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">1</intProp>
          </ResponseAssertion>
          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Assert 5 - so ket qua dat toi thieu theo CSV" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper

def expected = vars.get("expect_min_count") as Integer
def headers = prev.getResponseHeaders().toLowerCase()

if (!headers.contains("application/json")) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("Phan hoi khong phai JSON (HTTP " + prev.getResponseCode() + ") voi tu khoa [" + vars.get("search_term") + "] - noi chuoi SQL o server.js:144")
    return
}

def payload = new JsonSlurper().parseText(prev.getResponseDataAsString())

if (!(payload instanceof List)) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("Ky vong mot mang JSON, nhan duoc " + payload.getClass().getSimpleName())
    return
}

if (payload.size() >= expected) {
    return
}

AssertionResult.setFailure(true)
AssertionResult.setFailureMessage("Tu khoa [" + vars.get("search_term") + "] ky vong toi thieu " + expected + " san pham, chi nhan duoc " + payload.size())</stringProp>
          </JSR223Assertion>
